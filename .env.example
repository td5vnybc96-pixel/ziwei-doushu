# AI 解读（可选；排盘和 13 维数据查询不需要 API Key）
# 支持 deepseek、openai、mimo（OpenAI 兼容协议）
AI_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 或其他兼容服务
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 小米 MiMo 等 OpenAI 兼容服务
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL=
